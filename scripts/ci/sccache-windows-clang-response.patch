+/// Preserve the expanded SingleCompileCommand for hashing and distribution.
+/// Only local GNU-driver Clang compilation opts into response-file transport.
+#[cfg(windows)]
+#[derive(Debug)]
+struct WindowsClangCompileCommand(crate::compiler::SingleCompileCommand);
+
+#[cfg(windows)]
+#[async_trait]
+impl crate::compiler::CompileCommandImpl for WindowsClangCompileCommand {
+    fn get_executable(&self) -> PathBuf {
+        self.0.executable.clone()
+    }
+    fn get_arguments(&self) -> Vec<OsString> {
+        self.0.arguments.clone()
+    }
+    fn get_env_vars(&self) -> Vec<(OsString, OsString)> {
+        self.0.env_vars.clone()
+    }
+    fn get_cwd(&self) -> PathBuf {
+        self.0.cwd.clone()
+    }
+    async fn execute<T>(
+        &self,
+        _: &crate::server::SccacheService<T>,
+        creator: &T,
+    ) -> Result<process::Output>
+    where
+        T: CommandCreatorSync,
+    {
+        let command = &self.0;
+        let executable = crate::util::resolve_compiler_avoiding_wrapper(
+            &command.executable,
+            &command.env_vars,
+        );
+        let mut cmd = creator.clone().new_command_sync(&executable);
+        let response_file = windows_response_file(
+            &executable,
+            command.arguments.iter().map(OsString::as_os_str),
+        )?;
+        if let Some(file) = &response_file {
+            let mut argument = OsString::from("@");
+            argument.push(file.path());
+            cmd.arg("--rsp-quoting=posix").arg(argument);
+        } else {
+            cmd.args(&command.arguments);
+        }
+        cmd.env_clear()
+            .envs(command.env_vars.clone())
+            .current_dir(&command.cwd);
+        let result = run_input_output(cmd, None).await;
+        drop(response_file);
+        result
+    }
+}
+
+/// Spill only oversized Windows Clang commands. The caller retains the file
+/// through child completion; hashing still sees the original expanded arguments.
+#[cfg(windows)]
+pub(super) fn windows_response_file<'a>(
+    executable: &'a Path,
+    arguments: impl Iterator<Item = &'a std::ffi::OsStr> + Clone,
+) -> Result<Option<tempfile::NamedTempFile>> {
+    use std::os::windows::ffi::OsStrExt;
+
+    // Upper bound for Rust's Windows argv quoting. Reserve 1 KiB for the fixed
+    // preprocessor prefix, separators and NUL; CreateProcessW permits 32767 units.
+    let length = std::iter::once(executable.as_os_str())
+        .chain(arguments.clone())
+        .map(|arg| arg.encode_wide().count().saturating_mul(2).saturating_add(3))
+        .fold(1024usize, usize::saturating_add);
+    if length <= 30_000 {
+        return Ok(None);
+    }
+
+    let mut file = tempfile::Builder::new()
+        .prefix("sccache-clang-")
+        .suffix(".rsp")
+        .tempfile()?;
+    let mut writer = io::BufWriter::new(file.as_file_mut());
+    // GNU response quoting, not Windows argv quoting. Inside double quotes,
+    // escape every backslash and double quote; UTF-8 preserves non-ASCII text.
+    for argument in arguments {
+        let argument = argument
+            .to_str()
+            .context("Windows Clang response argument is not valid Unicode")?;
+        writer.write_all(b"\"")?;
+        for ch in argument.chars() {
+            if ch == '\\' || ch == '"' {
+                writer.write_all(b"\\")?;
+            }
+            let mut bytes = [0; 4];
+            writer.write_all(ch.encode_utf8(&mut bytes).as_bytes())?;
+        }
+        writer.write_all(b"\"\n")?;
+    }
+    writer.flush()?;
+    drop(writer);
+    Ok(Some(file))
+}
