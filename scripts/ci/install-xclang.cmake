# Run with cmake -DXCLANG_INSTALL_DIR=<directory> -P scripts/ci/install-xclang.cmake.
# XCLANG_ROOT is <directory>/xclang; GitHub Actions also receives it through GITHUB_ENV.
cmake_minimum_required(VERSION 3.28)
set(XCLANG_VERSION "23.1.3.6")
if(NOT XCLANG_INSTALL_DIR)
    message(FATAL_ERROR "Set XCLANG_INSTALL_DIR to the compiler installation directory")
endif()
cmake_path(ABSOLUTE_PATH XCLANG_INSTALL_DIR NORMALIZE)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
if(host_arch MATCHES "^(arm64|aarch64|ARM64)$" OR "$ENV{RUNNER_ARCH}" STREQUAL "ARM64")
    set(host_arch aarch64)
else()
    set(host_arch x86_64)
endif()
if(CMAKE_HOST_WIN32)
    set(host "${host_arch}-w64-mingw32")
    set(exe ".exe")
elseif(CMAKE_HOST_APPLE)
    if(NOT host_arch STREQUAL "aarch64")
        message(FATAL_ERROR "Only Apple Silicon macOS is supported")
    endif()
    set(host "${host_arch}-apple-darwin")
    set(exe "")
else()
    set(host "${host_arch}-unknown-linux-gnu")
    set(exe "")
endif()

# Official 23.1.3.6 SHA256SUMS, pinned here as well as checked against the release.
set(sha_x86_64_unknown_linux_gnu cdcb0975bfc7676f9d043c0fcee67ba00e700e6eed8bf2d9f6153def62c1316d)
set(sha_aarch64_unknown_linux_gnu fe1f16849bebd95634722f3c296f0017f56fc1f14878689763424cc54a66118c)
set(sha_x86_64_w64_mingw32 dbcd08d897cd5b9ae9d09f5f8c70b2156b3f46e31c735327f1776c9b26f9f632)
set(sha_aarch64_w64_mingw32 58e244873bba2eecf71c0a65e27ceb2a4812e19a7c713cef89aa4f542cf2ea2b)
set(sha_aarch64_apple_darwin 23c80ed7975bbdc94395ae82ed5dff0902439329b49763114b20a7e3c51044c2)
string(REPLACE "-" "_" hash_key "${host}")
set(expected_sha "${sha_${hash_key}}")
set(archive "xclang-${XCLANG_VERSION}-${host}.tar.xz")
set(release "https://github.com/clice-io/xclang/releases/download/${XCLANG_VERSION}")
file(MAKE_DIRECTORY "${XCLANG_INSTALL_DIR}")
file(DOWNLOAD "${release}/SHA256SUMS" "${XCLANG_INSTALL_DIR}/SHA256SUMS"
    TLS_VERIFY ON TIMEOUT 60 INACTIVITY_TIMEOUT 20 STATUS download_status)
list(GET download_status 0 status_code)
if(NOT status_code EQUAL 0)
    message(FATAL_ERROR "Cannot download xclang SHA256SUMS: ${download_status}")
endif()
file(STRINGS "${XCLANG_INSTALL_DIR}/SHA256SUMS" checksum_lines)
if(NOT "${expected_sha}  ${archive}" IN_LIST checksum_lines)
    message(FATAL_ERROR "Pinned xclang checksum does not match release SHA256SUMS: ${archive}")
endif()
file(DOWNLOAD "${release}/${archive}" "${XCLANG_INSTALL_DIR}/${archive}"
    EXPECTED_HASH "SHA256=${expected_sha}" TLS_VERIFY ON SHOW_PROGRESS
    TIMEOUT 600 INACTIVITY_TIMEOUT 60)
file(ARCHIVE_EXTRACT INPUT "${XCLANG_INSTALL_DIR}/${archive}" DESTINATION "${XCLANG_INSTALL_DIR}")
file(REMOVE "${XCLANG_INSTALL_DIR}/${archive}")
set(XCLANG_ROOT "${XCLANG_INSTALL_DIR}/xclang")
foreach(tool clang clang++ clang-scan-deps xclang)
    if(NOT EXISTS "${XCLANG_ROOT}/bin/${tool}${exe}")
        message(FATAL_ERROR "Incomplete xclang archive: missing ${tool}${exe}")
    endif()
endforeach()
if(NOT EXISTS "${XCLANG_ROOT}/lib/cmake/xclang/toolchain.cmake")
    message(FATAL_ERROR "Incomplete xclang archive: missing official CMake toolchain")
endif()
execute_process(COMMAND "${XCLANG_ROOT}/bin/xclang${exe}" --version
    OUTPUT_VARIABLE installed_version ERROR_VARIABLE version_error RESULT_VARIABLE version_status)
if(NOT version_status EQUAL 0 OR NOT installed_version MATCHES "23\\.1\\.3\\.6")
    message(FATAL_ERROR "Unexpected xclang release: ${installed_version}${version_error}")
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND "$ENV{OSB_NATIVE_COMPILER_ROOT}" STREQUAL "")
    # Ubuntu's development packages belong to its native C SDK, not the
    # archive's glibc 2.17 sysroot. An explicit native wrapper supplies its
    # own SDK instead (for example Nix's Windows cross-build host tools).
    include("${CMAKE_CURRENT_LIST_DIR}/configure-native-linux-sdk.cmake")
endif()
message(STATUS "${installed_version}XCLANG_ROOT=${XCLANG_ROOT}")
if(DEFINED ENV{GITHUB_ENV})
    file(APPEND "$ENV{GITHUB_ENV}" "XCLANG_ROOT=${XCLANG_ROOT}\n")
    file(APPEND "$ENV{GITHUB_PATH}" "${XCLANG_ROOT}/bin\n")
endif()
