    "path": "/stats/player_primary_blshield.lua",
    "name": "randgenblshields",
    "version": "5.3",
    "size": 5796,
    "hash": "ad5f413e94b40aca",
    "kind": "asset",
    "reason": "Pass integral world-clock seconds to math.randomseed so returning players can initialize shields; preserve the existing init chain, damage handling and boss loot.",
    "edits": [
      {
        "before": "math.randomseed(world.time())",
        "after": "math.randomseed(math.floor(world.time()))",
        "count": 1
      }
    ]
  },
