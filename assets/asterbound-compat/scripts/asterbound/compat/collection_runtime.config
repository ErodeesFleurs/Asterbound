  {
    "path": "/interface/scripted/collections/collectionsgui.lua",
    "name": "CustomCollectionsUI",
    "version": "0.1.2",
    "size": 5229,
    "hash": "7447794a2d31b592",
    "kind": "asset",
    "reason": "Keep custom collection selection by its data ID rather than a hard-coded radio index. Added native tabs must not redirect selection to an unrelated collection; returning to the custom tab shows its list again.",
    "guards": [
      {
        "path": "/interface/scripted/collections/collectionsgui.config.patch",
        "name": "CustomCollectionsUI",
        "version": "0.1.2",
        "size": 2380,
        "hash": "bbd9c7a30231e9c9",
        "kind": "patch"
      },
      {
        "name": "Elithian_Races_Mod",
        "version": "2.3.12",
        "path": "/interface/scripted/collections/collectionsgui.config.patch",
        "size": 1639,
        "hash": "de1118f1d461aef4",
        "kind": "patch"
      },
      {
        "name": "ElithianRacesGoodGamesFixes",
        "version": "1.5",
        "path": "/interface/scripted/collections/collectionsgui.config.patch",
        "size": 1012,
        "hash": "9b7f5c75fb7bb2ca",
        "kind": "patch"
      },
      {
        "name": "base",
        "path": "/interface/scripted/collections/collectionsgui.config",
        "size": 6083,
        "hash": "2835dd290224e8b6"
      }
    ],
    "edits": [
      {
        "before": "function update(dt)\n-- BEGIN CUSTOM CODE: hack to work around list widget selection issues\n  local selected = widget.getListSelected(self.customList)\n  if selected then\n    selected = widget.getData(string.format(\"%s.%s\", self.customList, selected))\n    if selected ~= self.collectionName then\n      populateList(selected)\n      self.customCollectionName = selected\n      widget.setSelectedOption(\"collectionTabs\", 7) -- Number here must be equal to the number of vanilla collections\n    end\n    return\n  end\n-- END CUSTOM CODE\n  if self.collectionName and self.collectionName ~= selected then\n    local selected = widget.getSelectedData(\"collectionTabs\")\n    if self.collectionName ~= selected then\n      populateList()\n    else\n      for _,collectable in pairs(player.collectables(self.collectionName)) do\n        if not self.playerCollectables[collectable] then\n          populateList(self.customCollectionName) --\n          break\n        end\n      end\n    end\n  end\nend\n\n",
        "after": "function update(dt)\n  local selected = widget.getListSelected(self.customList)\n  if selected then\n    selected = widget.getData(string.format(\"%s.%s\", self.customList, selected))\n    if selected ~= self.collectionName then\n      populateList(selected)\n      self.customCollectionName = selected\n      widget.setSelectedOption(\"collectionTabs\", self.customCollectionOption)\n    end\n    return\n  end\n\n  local collectionName = widget.getSelectedData(\"collectionTabs\")\n  if collectionName == \"customCollectionsVisible\" then\n    collectionName = self.customCollectionName\n  end\n  if self.collectionName ~= collectionName then\n    populateList(collectionName)\n  elseif self.collectionName and self.collectionName ~= \"customCollections\" then\n    for _,collectable in pairs(player.collectables(self.collectionName)) do\n      if not self.playerCollectables[collectable] then\n        populateList(collectionName)\n        break\n      end\n    end\n  end\nend\n\n",
        "count": 1
      },
      {
        "before": "  if collectionName == \"customCollectionsVisible\" then return end -- special case: do nothing\n",
        "after": "",
        "count": 1
      },
      {
        "before": "function selectCollection(index, data)\n  populateList()\nend",
        "after": "function selectCollection(index, data)\n  if data == \"customCollectionsVisible\" then return end\n  self.customCollectionName = nil\n  populateList()\nend",
        "count": 1
      },
      {
        "before": "  self.iconSize = config.getParameter(\"iconSize\")",
        "after": "  self.iconSize = config.getParameter(\"iconSize\")\n  for _,button in ipairs(config.getParameter(\"gui\").collectionTabs.buttons) do\n    if button.data == \"customCollectionsVisible\" then\n      self.customCollectionOption = button.id\n    end\n  end",
        "count": 1
      }
    ]
  },
  {
