        "count": 1
      },
      {
        "before": "ipairs(global)",
        "after": "ipairs(orderedFavorites)",
        "count": 1
      },
      {
        "before": "global[ia],global[ib]=global[ib],global[ia]",
        "after": "orderedFavorites[ia],orderedFavorites[ib]=orderedFavorites[ib],orderedFavorites[ia]",
        "count": 1
      },
      {
        "before": "self.favoriteSortedEntries=global",
        "after": "self.favoriteSortedEntries=orderedFavorites",
        "count": 1
      }
    ],
    "kind": "asset",
    "reason": "Rename Lua5.5 reserved local while retaining the favorites ordering/move operation."
  },
  {
    "path": "/pat/classicquickbar/modules/actions.lua",
    "name": "zzQuickbarPlus",
    "version": "2.3",
    "size": 1174,
    "hash": "cf2db5e437916f32",
    "edits": [
      {
        "before": "local actions = _ENV.actions or {}",
        "after": "local actionScripts = {}\nlocal function executeScript(path)\n  local chunk = actionScripts[path]\n  if not chunk then\n    chunk = loadstring(root.assetData(path), path, _ENV)\n    actionScripts[path] = chunk\n  end\n  return chunk()\nend\n\nlocal actions = _ENV.actions or {}",
        "count": 1
      },
      {
        "before": "  _SBLOADED[script] = nil\n  require(script)",
        "after": "  executeScript(script)",
        "count": 2
      }
    ],
    "kind": "asset",
    "reason": "Cache compiled entry chunks privately and execute each action, retaining params/module side effects and ordinary strict require for dependencies."
  },
  {
    "path": "/sys/quickbar/quickbar.lua",
    "name": "QuickbarMini",
    "version": "Beta v0.1.5h-aa94060",
    "size": 1840,
    "hash": "3156ab49afd3dfcc",
    "edits": [
      {
        "before": "local actions = { }",
        "after": "local actionScripts = {}\nlocal function executeScript(path)\n  local chunk = actionScripts[path]\n  if not chunk then\n    chunk = loadstring(root.assetData(path), path, _ENV)\n    actionScripts[path] = chunk\n  end\n  return chunk()\nend\n\nlocal actions = { }",
        "count": 1
      },
      {
        "before": "  _SBLOADED[script] = nil require(script) -- force execute every time",
        "after": "  executeScript(script) -- execute this entry on every click",
        "count": 1
      },
      {
        "before": "  _SBLOADED[mf] = nil require(mf) -- force execute",
        "after": "  executeScript(mf) -- execute this entry on every click",
        "count": 1
      }
    ],
    "kind": "asset",
    "reason": "Retain repeated modern and legacy quickbar entry execution without the removed engine cache table."
  },
  {
    "path": "/scripts/terra_scriptLoader.lua",
    "name": "terraliblite",
    "version": "1.12",
    "size": 7340,
    "hash": "55218fdfb6c269ec",
    "edits": [
      {
        "before": "scriptLoader = {}",
        "after": "local compiledScripts = {}\nlocal function executeScript(path)\n  local chunk = compiledScripts[path]\n  if not chunk then\n    chunk = loadstring(root.assetData(path), path, _ENV)\n    compiledScripts[path] = chunk\n  end\n  return chunk()\nend\n\nscriptLoader = {}",
        "count": 1
      },
      {
        "before": "                _SBLOADED[v] = nil\n                require(v)",
        "after": "                executeScript(v)",
        "count": 1
      }
    ],
    "kind": "asset",
    "reason": "Execute each sandbox entry using a private compiled chunk; preserve the existing per-script-list output cache and wrapped environment."
  },
