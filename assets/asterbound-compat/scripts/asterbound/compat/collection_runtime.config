    "version": "1.0",
    "size": 4757,
    "hash": "21c37ff181727f3c",
    "edits": [
      {
        "before": "  for k, v in next, o, nil do\n",
        "after": "  for originalKey, v in next, o, nil do\n    local k = originalKey\n",
        "count": 1
      }
    ],
