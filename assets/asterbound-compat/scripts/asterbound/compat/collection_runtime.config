        "hash": "2835dd290224e8b6"
      }
    ],
    "edits": [
      {
        "before": "[\n  {\n    \"op\": \"add\",\n    \"path\": \"/customCollectionsTitle\",\n    \"value\": \"Custom Collections\"\n  },\n  {\n    \"op\": \"add\",\n    \"path\": \"/customCollections\",\n    \"value\": []\n  },\n  {\n    \"op\": \"add\",\n    \"path\": \"/gui/scrollAreaCustom\",\n    \"value\": {\n      \"type\": \"scrollArea\",\n      \"rect\": [ 38, 35, 256, 205 ],\n      \"children\": {\n        \"customCollectionList\": {\n          \"type\": \"list\",\n          \"//callback\": \"selectCustomCollection\",\n          \"schema\": {\n            \"spacing\": [ 4, 2 ],\n            \"memberSize\": [ 204, 11 ],\n            \"listTemplate\": {\n              \"background\": {\n                \"type\": \"image\",\n                \"file\": \"/interface/scripted/collections/tab_customcollections_bg.png\",\n                \"position\": [ 0, 1 ],\n                \"zlevel\": -1\n              },\n              \"collectionName\": {\n                \"type\": \"label\",\n                \"position\": [ 102, 1 ],\n                \"hAnchor\": \"mid\",\n                \"width\": 198,\n                \"value\": \"Replace Me\"\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/0/position/1\",\n    \"value\": 196\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/1/position/1\",\n    \"value\": 172\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/2/position/1\",\n    \"value\": 148\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/3/position/1\",\n    \"value\": 124\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/4/position/1\",\n    \"value\": 100\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/collectionTabs/buttons/5/position/1\",\n    \"value\": 76\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/gui/colle