  {
    "path": "/items/active/weapons/floran_lwd/lua/heavycombo.lua",
    "name": "Floran's_ArcanaAddon",
    "version": "2.978",
    "size": 47454,
    "hash": "ba377a072e1bce99",
    "kind": "asset",
    "reason": "Read the native unique-effect state for stance recovery and the maximum-level burning transition; the obsolete isAffected predicate is absent.",
    "edits": [
      {"before": "  if status.isAffected then\n    for level, effect in pairs(self.effectForLevel) do\n      if status.isAffected(effect) then return level end\n    end\n  end\n  local effectsList = status.statusProperty(\"activeStatusEffects\") or {}\n  for _, effName in ipairs(effectsList) do\n    for level, effect in pairs(self.effectForLevel) do\n      if effName == effect then return level end\n    end\n  end\n  if status.uniqueStatusEffectActive then\n    for level, effect in pairs(self.effectForLevel) do\n      if status.uniqueStatusEffectActive(effect) then return level end\n    end\n  end", "after": "  for level, effect in pairs(self.effectForLevel) do\n    if status.uniqueStatusEffectActive(effect) then return level end\n  end", "count": 1},
      {"before": "  local has = false\n  if status.isAffected then has = status.isAffected(self.currentEffect)\n  else\n    local l = status.statusProperty(\"activeStatusEffects\") or {}\n    for _, e in ipairs(l) do if e == self.currentEffect then has = true; break end end\n  end\n  if not has then self:addEffect(self.currentEffect) end", "after": "  if not status.uniqueStatusEffectActive(self.currentEffect) then self:addEffect(self.currentEffect) end", "count": 1},
      {"before": "and status.isAffected and status.isAffected(\"burning\")", "after": "and status.uniqueStatusEffectActive(\"burning\")", "count": 1}
    ]
  },
  {
    "path": "/items/active/weapons/floran_ttx/lua/arcana_greatspear_combo.lua",
    "name": "Floran's_ArcanaAddon",
    "version": "2.978",
    "size": 29066,
    "hash": "354b7b516e3d26ab",
    "kind": "asset",
    "reason": "Observe the actual stance effect instead of an obsolete predicate or an unrelated status property, so the held spear does not reapply an existing buff every update.",
    "edits": [
      {"before": "    local has = false\n    if status.isAffected then\n      has = status.isAffected(self.currentBuff)\n    else\n      local effects = status.statusProperty(\"activeStatusEffects\") or {}\n      for _, e in ipairs(effects) do\n        if e == self.currentBuff then\n          has = true\n          break\n        end\n      end\n    end\n    if not has then", "after": "    if not status.uniqueStatusEffectActive(self.currentBuff) then", "count": 1}
    ]
  }
