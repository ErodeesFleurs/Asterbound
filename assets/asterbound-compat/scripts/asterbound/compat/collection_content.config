    "size": 6373,
    "hash": "20f646936f191d38",
    "edits": [
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"它的眼睛非常大。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/0\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"什么是“下”，什么又是“上”？你可说不清楚。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/1\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"什么是“下”，什么又是“上”？你可说不清楚。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/0\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"它们就算没长眼睛，也不影响他们精确地定位你的坐标。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/2\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"它们就算没长眼睛，也不影响他们精确地定位你的坐标。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/1\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"今天的和平是虚假的和平。因为他们只不过是在暗处注视着我们。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/3\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"今天的和平不过是一张仪式性的面具。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/2\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"巴拉拉卡 巴-巴口 萨本卡。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/4\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"巴拉拉卡 巴-巴口 萨本卡。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/3\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"到处都有眼睛，你难道感觉不到吗？\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/5\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"到处都有眼睛，你难道感觉不到吗？\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/4\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"附近有一个巨物。那家伙正在无声而迟缓地动着。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/6\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"只是测试下你是人还是会变形的怪物：你知道现在是哪一年吗？\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/7\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"巨兽的伴生迷雾会在不知不觉中滚滚而来。 你最终会体会到什么叫天地一色，但那时通常为时已晚。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/8\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"在我们脚下的某个地方，一头巨大的生物正在沉睡。它很快就会醒来。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/9\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"有时候我觉得行星就像恒星一样是有生命的。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/10\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"有时候我觉得，我们脚下这颗星球是活的。\",\n    \"path\": \"/scriptConfig/dialog/converse/default/default/6\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"在它下蛋之前弄死它！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/0\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"离我远点！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/1\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"离我远点！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/0\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"又派了一个变形怪过来，是吗？\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/2\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"瞑瞑盲眼之辈，如何得见终极！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/3\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"瞑瞑盲眼之辈，如何得见终极！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/1\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"恒星会赐众生以死亡！我必携荣耀而恭迎！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/4\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"蝼蚁之辈，也敢学螳臂当车！闪开！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/5\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"蝼蚁之辈，也敢学螳臂当车！闪开！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/2\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"聒噪！死！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/6\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"聒噪！死！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/3\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"你打断了我的思绪！从我脑子里滚出去！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/7\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"你打断了我的思绪！从我脑子里滚出去！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/5\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"啊哈！一头试图把自己伪装成一个小不点的巨兽！你骗不了我！\",\n    \"path\": \"/scriptConfig/dialog/attack/default/default/8\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"另一个灵魂再次获得自由。\",\n    \"path\": \"/scriptConfig/dialog/killedTarget/default/default/0\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"向那些希望我们死去的星星致敬。\",\n    \"path\": \"/scriptConfig/dialog/killedTarget/default/default/1\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"我们都一无所有了。\",\n    \"path\": \"/scriptConfig/dialog/killedTarget/default/default/2\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"再一次，面对我！\",\n    \"path\": \"/scriptConfig/dialog/reattack/default/default/3\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"又来面对我啦，哎？像个对兴奋剂上瘾的恋人！\",\n    \"path\": \"/scriptConfig/dialog/reattack/default/default/3\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"...\",\n    \"path\": \"/scriptConfig/dialog/lostTarget/default/default/0\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"跑了，不过跑不掉的……\",\n    \"path\": \"/scriptConfig/dialog/lostTarget/default/default/1\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"走了，但不会永远消失……\",\n    \"path\": \"/scriptConfig/dialog/lostTarget/default/default/0\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"哼，想逃。等着。\",\n    \"path\": \"/scriptConfig/dialog/lostTarget/default/default/2\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"那就跑吧，躲起来吧……\",\n    \"path\": \"/scriptConfig/dialog/lostTarget/default/default/1\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"只有怂包才不敢面对自己的结局。\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/0\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"给我回来，你这个小懦夫！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/0\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"躲避不会改变你的命运。\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/1\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"躲藏只会延缓不可避免的结局！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/2\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"谁说我躲了，有本事单挑！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/2\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"谁说我躲了，有本事单挑！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/1\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"躲一时还能躲一世不成？\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/3\"\n  },",
        "after": "",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"没有谁能一直躲下去！就算是躲在远离沸腾的星空的黑暗中也不行！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/4\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"没有谁能一直躲下去！就算是躲在远离沸腾的星空的黑暗中也不行！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/3\"\n  }",
        "count": 1
      },
      {
        "before": "{\n    \"op\": \"replace\",\n    \"value\": \"出来吧！ 一个人躲起来有什么意思！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/5\"\n  }",
        "after": "{\n    \"op\": \"replace\",\n    \"value\": \"出来，让我开枪打你！\",\n    \"path\": \"/scriptConfig/dialog/cantReach/default/default/4\"\n  }",
        "count": 1
      }
    ],
    "kind": "patch",
