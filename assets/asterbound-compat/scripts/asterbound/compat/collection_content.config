  {
    "path": "/objects/GICEXP/esc_shop_nt_commander/esc_shop_nt_commander.object.patch",
    "name": "[GIC]恶化扩展——汉化",
    "version": "2.03",
    "size": 1155,
    "hash": "358ad6db6a17eae2",
    "edits": [
      {
        "before": "/interactData/paneLayoutOverride/windowtitle/title",
        "after": "/shortdescription",
        "count": 1
      },
      {
        "before": "/interactData/paneLayoutOverride/windowtitle/subtitle",
        "after": "/description",
        "count": 1
      },
      {
        "before": ",\n  {\n    \"op\": \"replace\",\n    \"path\": \"/chatOptions/0\",\n    \"value\": \"“不要多愁善感，这是制约怠惰之人的致命弱点”——或许，人类的‘文明’正是被多愁善感所拖累着啊\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/chatOptions/1\",\n    \"value\": \"‘当你满足了欲望，人们就会开始跟随你’——是啊，这话可太有道理了\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/chatOptions/2\",\n    \"value\": \"‘财富不会眷顾懒惰之人’——这也就是我们必须果断做出改变的原因\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/chatOptions/3\",\n    \"value\": \"‘停滞等于死亡，永远向前迈进’——如没有这样的蓬勃的精神，我们的命运恐怕......\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/chatOptions/4\",\n    \"value\": \"要是创始人能看到我们现在的样子就好了\"\n  }",
        "after": "",
        "count": 1
      }
    ],
    "kind": "patch",
    "target": "/objects/GICEXP/esc_shop_nt_commander/esc_shop_nt_commander.object",
    "reason": "Retain the merchant name and role translations on the live object tooltip. The old random chat/window operations belong to the retired merchant interface; the exact current ScriptPane exclusively runs the existing authored Chinese visual-novel scenes, which remain unchanged.",
    "guards": [
      {
        "path": "/objects/GICEXP/esc_shop_nt_commander/esc_shop_nt_commander.object",
        "name": "[GIC]The Escalate Expansion",
        "version": "2.03",
        "size": 1288,
        "hash": "dd2f5b7741a06eb0"
      },
      {
        "path": "/interface/scripted/esc_vntest/esc_vntestobject.lua",
        "name": "[GIC]The Escalate Expansion",
        "version": "2.03",
