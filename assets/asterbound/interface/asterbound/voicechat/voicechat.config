{
  "scripts" : ["/interface/asterbound/voicechat/voicechat.lua"],
  "scriptDelta" : 1,
  "scriptWidgetCallbacks" : [
    "selectDevice",
    "voiceToggle",
    "switchVoiceMode"
  ],

  "canvasClickCallbacks" : {
    "inputVolume" : "inputVolume",
    "voiceVolume" : "voiceVolume",
    "threshold" : "threshold"
  },

  "gui" : {
    "panefeature" : {
      "type" : "panefeature",
        "positionLocked" : false
    },
    "background" : {
      "type" : "background",
      "fileHeader" : "/interface/asterbound/voicechat/header.png",
      "fileBody" : "/interface/asterbound/voicechat/body.png",
      "fileFooter" : "/interface/asterbound/voicechat/footer.png"
    },
    "close" : {
      "type" : "button",
      "position" : [98, 1],
      "caption" : "Back",
      "base" : "/interface/button.png?scalenearest=1;0.95",
      "hover" : "/interface/buttonhover.png?scalenearest=1;0.95"
    },

    "voiceVolumeLabel" : {
      "type" : "label",
      "value" : "TheirVolume",
      "position" : [30, 179],
      "wrapWidth" : 48,
      "lineSpacing" : 0.75,
      "hAnchor" : "mid",
      "vAnchor" : "mid"
    },
    "voiceVolume" : {
      "type" : "canvas",
      "rect" : [55, 172, 223, 187],
      "captureMouseEvents" : true,
      "captureKeyboardEvents" : false
    },

    "inputVolumeLabel" : {
      "type" : "label",
      "value" : "YourVolume",
      "position" : [30, 162],
      "wrapWidth" : 48,
      "lineSpacing" : 0.75,
      "hAnchor" : "mid",
      "vAnchor" : "mid"
    },
    "inputVolume" : {
      "type" : "canvas",
      "rect" : [55, 155, 223, 170],
      "captureMouseEvents" : true,
      "captureKeyboardEvents" : false
    },

    "enableVoiceToggle" : {
      "type" : "button",
      "pressedOffset" : [0, 0],
      "position" : [11, 190],
      "base" : "/interface/asterbound/voicechat/bigtab_off.png",
      "hover" : "/interface/asterbound/voicechat/bigtab_off_stay.png",
      "pressed" : "/interface/asterbound/voicechat/bigtab_on.png",
      "callback" : "voiceToggle",
      "fontSize" : 16,
      "zlevel" : 1
    },


    "voiceModeLabel" : {
      "type" : "label",
      "value" : "VoiceMode",
      "position" : [30, 136],
      "wrapWidth" : 32,
      "lineSpacing" : 0.75,
      "hAnchor" : "mid",
      "vAnchor" : "mid"
    },
    "pushToTalk" : {
      "type" : "button",
      "pressedOffset" : [0, 0],
      "position" : [55, 124],
      "base" : "/interface/asterbound/voicechat/pushtotalk_off.png",
      "hover" : "/interface/asterbound/voicechat/pushtotalk_stay.png",
      "pressed" : "/interface/asterbound/voicechat/pushtotalk_on.png",
      "callback" : "switchVoiceMode",
      "fontSize" : 16,
      "zlevel" : 1
    },

    "voiceActivity" : {
      "type" : "button",
      "pressedOffset" : [0, 0],
      "position" : [157, 124],
      "base" : "/interface/asterbound/voicechat/activity_off.png",
      "hover" : "/interface/asterbound/voicechat/activity_stay.png",
      "pressed" : "/interface/asterbound/voicechat/activity_on.png",
      "callback" : "switchVoiceMode",
      "fontSize" : 16,
      "zlevel" : 1
    },

    "thresholdLevel" : {
      "type" : "label",
      "value" : "Threshold",
      "position" : [30, 113],
      "wrapWidth" : 48,
      "lineSpacing" : 0.75,
      "hAnchor" : "mid",
      "vAnchor" : "mid"
    },
    "threshold" : {
      "type" : "canvas",
      "rect" : [55, 106, 223, 121],
      "captureMouseEvents" : true,
      "captureKeyboardEvents" : false
    },

    "devices" : {
      "type" : "scrollArea",
      "rect" : [8, 17, 242, 102],
      "children" : {
        "list" : {
          "type" : "list",
          "schema" : {
            "spacing" : [0, 1],
            "memberSize" : [222, 18],
            "listTemplate" : {
              "button" : {
                "type" : "button",
                "callback" : "selectDevice",
                "caption" : "Unnamed",
                "base" : "/interface/asterbound/voicechat/tab_off.png",
                "hover" : "/interface/asterbound/voicechat/tab_off_stay.png",
                "pressed" : "/interface/asterbound/voicechat/tab_on.png",
