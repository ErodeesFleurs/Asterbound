// Default config for all crafting interfaces, vanilla and modded.

{ "default" : {
  // If true, craft the entire selected quantity immediately, as for zero-duration recipes.
  "disableTimer" : false,

  // Crafts per completed timer period, capped by the remaining selected quantity.
  // A timed recipe completes at most one such batch per interface update.
  "craftCount" : 1,

  // This is how many of any item can be crafted at once.
  // This is also used by merchants.
  "maxSpinCount" : 9999
} }
