#include "AsterboundVersion.h"

1 VERSIONINFO
FILEVERSION     ASTERBOUND_VERSION_COMMA
PRODUCTVERSION  ASTERBOUND_VERSION_COMMA
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Chucklefish LTD"
      VALUE "FileDescription", "Asterbound Server"
      VALUE "FileVersion", ASTERBOUND_VERSION_STRING
      VALUE "InternalName", "asterbound_server"
      VALUE "LegalCopyright", "Chucklefish LTD"
      VALUE "OriginalFilename", "asterbound_server.exe"
      VALUE "ProductName", "Asterbound Server"
      VALUE "ProductVersion", ASTERBOUND_VERSION_STRING
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
icon ICON "asterbound_server.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "starbound_server.exe.manifest"
