#include "AsterboundVersion.h"

1 VERSIONINFO
FILEVERSION     ASTERBOUND_VERSION_COMMA
PRODUCTVERSION  ASTERBOUND_VERSION_COMMA
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Chucklefish LTD"
      VALUE "FileDescription", "Asterbound"
      VALUE "FileVersion", ASTERBOUND_VERSION_STRING
      VALUE "InternalName", "asterbound"
      VALUE "LegalCopyright", "Chucklefish LTD"
      VALUE "OriginalFilename", "asterbound.exe"
      VALUE "ProductName", "Asterbound"
      VALUE "ProductVersion", ASTERBOUND_VERSION_STRING
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
icon ICON "asterbound.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "starbound.exe.manifest"
