{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "glew",
    { "name": "sdl3", "default-features": false, "features": ["wayland", "x11", "alsa", "ibus", "dbus"], "platform": "linux" },
    { "name": "sdl3", "platform": "!linux" },
    { "name": "cpptrace", "platform": "!windows" },
    "libvorbis",
    "zlib-ng",
    "freetype",
    "libpng",
    "libjpeg-turbo",
    "opus",
    { "name": "libsodium", "version>=": "1.0.21" },
    "zstd",
    { "name": "mimalloc", "default-features": false },
    "re2",
    { "name": "imgui", "features": ["sdl3-binding", "opengl3-binding", "freetype"] },
    { "name": "curl", "version>=": "8.8.0", "default-features": false, "features": ["ssl", "idn"] },
    { "name": "cpr", "version>=": "1.14.2", "features": ["ssl"] }
  ],
  "features": {
    "vulkan": {
      "description": "Vulkan client renderer and runtime GLSL compiler",
      "dependencies": [
        "vulkan",
        "shaderc",
        { "name": "sdl3", "features": ["vulkan"] },
        { "name": "imgui", "features": ["vulkan-binding"] },
        { "name": "vulkan-loader", "features": ["wayland", "xcb", "xlib"], "platform": "linux" }
      ]
    },
    "benchmarks": {
      "description": "Standalone Google Benchmark performance executables",
      "dependencies": [{ "name": "benchmark", "version>=": "1.9.5" }]
    },
    "qt-tools": {
      "description": "Static Qt6 widgets for json_tool and mod_uploader",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["widgets", "thread", "png", "jpeg", "freetype", "harfbuzz"]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["xcb", "fontconfig"],
          "platform": "linux"
        }
      ]
    }
  }
}
